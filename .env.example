# GEMINI_API_KEY: Required for Gemini AI API calls (backend only — never prefix with VITE_).
# Set this in AI Studio Secrets, Vercel Environment Variables, or Render Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted (used for canonical URLs & sitemap.xml).
APP_URL="MY_APP_URL"

# CORS_ORIGIN: Optional comma-separated allowed frontend origins if frontend (Vercel) and backend (Render) are on different domains.
# Example: "https://open-share-box.vercel.app,https://clipindex.zotomic.com"
CORS_ORIGIN=""

# VITE_API_BASE_URL: Optional backend base URL for frontend builds when backend is hosted separately on Render.
# Leave empty when frontend and /api/* share the same domain (AI Studio, Vercel-only, or Render-only).
# Example: "https://open-share-box-api.onrender.com"
VITE_API_BASE_URL=""

# Optional: Meta WhatsApp Cloud API (server-side only — enables automated API reminder delivery alongside 1-click wa.me links)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

